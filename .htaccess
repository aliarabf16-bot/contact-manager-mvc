# Apache/XAMPP: do not allow directory listings or access to private files.
Options -Indexes

<FilesMatch "^(config(\.example)?\.php|README(\_AR)?\.md|START_HERE_AR\.md|\.gitignore|\.htaccess|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Extra defense: deny hidden files (including the .git directory contents).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
